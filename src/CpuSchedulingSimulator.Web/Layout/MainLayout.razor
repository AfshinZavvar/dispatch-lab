@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to simulator</a>
<header class="site-header">
    <a class="brand" href="/" aria-label="Dispatch Lab home">
        <span class="brand-mark" aria-hidden="true">DL</span>
        <span>
            <strong>Dispatch Lab</strong>
            <small>CPU scheduler debugger</small>
        </span>
    </a>
    <div class="header-readout" aria-label="Simulation model">
